#!/usr/bin/env crok --v0

# bsan does not instrument doctests.
set SKIP_IF_BSAN "1";
include "../../_setup.crok";
if skip != "" {
    exit script;
}
defer {
    $ cargo clean --quiet
}
$ cargo build --quiet
*
$ cargo test --doc --quiet
!
! running 1 test
! .
! test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in %{DATA}
!

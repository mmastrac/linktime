#!/usr/bin/env crok --v0

# bsan does not follow dlopen.
set SKIP_IF_BSAN "1";
set NEEDS_RUSTFLAGS "-C target-feature=-crt-static";
include "../../_setup.crok";
if skip != "" {
    exit script;
}
# dylib_load segfaults in dlopen with DragonFly pkg rust 1.98.1.
if TARGET_OS == "dragonfly" {
    exit script;
}
set CARGO_TARGET_DIR "target/system_no_crt_static";
defer {
    $ cargo clean --quiet
}
$ cargo build --lib --examples --quiet
*
$ cargo run --example dylib_load --quiet
unordered {
    ! + Foo::ctor
    ! + ctor bin
}
! ++ main start
unordered {
    ! +++ ctor STATIC_INT
    ! +++ ctor lib (-crt-static)
}
unordered {
    ! -- main end
    ! --- dtor lib
}
unordered {
    ! - Foo::dtor
    ! - dtor bin
}

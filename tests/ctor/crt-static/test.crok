#!/usr/bin/env crok --v0
# Apple: dylibs + crt-static unsupported here
if TARGET_OS == "macos" {
    exit script;
}
set RUSTFLAGS "-C target-feature=+crt-static";
defer {
    $ cargo clean --quiet
}
$ rustc -vV
%SET TARGET "$target"
*
! host: %{DATA:target}
*
$ cargo build --quiet --target $TARGET
*
$ cargo run --quiet --target $TARGET
if TARGET_OS == "openbsd" {
    # Appears to be a legit Rust/OpenBSD bug?
    ! -crt-static
}
if TARGET_OS != "openbsd" {
    ! +crt-static
}
! main

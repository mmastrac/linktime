#!/usr/bin/env crok --v0
# Missing `unsafe` on `#[ctor]` must fail the build by default.
set RUSTFLAGS "";
set CARGO_TARGET_DIR "target/warn_yes";
defer {
    $ cargo clean --quiet
}
$ cargo build
%EXIT 101
*
! Compiling warn-unsafe v0.0.0 %{DATA}

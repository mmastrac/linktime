{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022", "DOM"],
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "types": ["node"],
      "allowImportingTsExtensions": true
    },
    "include": ["js/**/*.mts"]
  }
